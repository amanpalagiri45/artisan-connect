# ARTISAN CONNECT - Backend Environment Configuration

# Server
PROJECT_NAME="Artisan Connect API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security & JWT
# Note: Generate a secure secret in production, e.g. using `openssl rand -hex 32`
SECRET_KEY="artisan-connect-super-secure-jwt-secret-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default is SQLite for zero-config local testing.
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/artisan_connect
DATABASE_URL="sqlite:///./artisan_connect.db"

# Google OAuth 2.0 / OpenID Connect
# Create a Web application credential in Google Cloud Console.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
FRONTEND_URL="http://localhost:5173"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173","http://127.0.0.1:8000","*"]
